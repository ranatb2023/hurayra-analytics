APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=hurayra_analytics
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Dashboards and "today" are in UK time; the database stays GMT.
APP_BUSINESS_TIMEZONE=Europe/London

# "No orders" alert (php artisan alerts:no-orders, scheduled hourly).
# Fires once per incident when no order has arrived for ALERT_NO_ORDERS_HOURS
# between ALERT_NO_ORDERS_FROM_HOUR and ALERT_NO_ORDERS_UNTIL_HOUR UK time.
ALERT_NO_ORDERS_HOURS=12
ALERT_NO_ORDERS_FROM_HOUR=8
ALERT_NO_ORDERS_UNTIL_HOUR=23
# Comma-separated recipients; blank disables email.
ALERT_EMAIL_TO=
# Optional Slack incoming-webhook URL.
ALERT_SLACK_WEBHOOK=

# Direct WooCommerce sync (php artisan woo:sync, every 15 minutes). READ ONLY:
# create a dedicated MySQL user with SELECT on the WordPress tables only, never
# the WordPress admin user. Leave WC_DB_HOST blank to keep using CSV uploads.
WC_DB_HOST=
WC_DB_PORT=3306
WC_DB_NAME=
WC_DB_USER=
WC_DB_PASS=
WC_TABLE_PREFIX=wp_

# Klaviyo email-performance module.
# Private key scopes required: campaigns:read, flows:read, metrics:read, lists:read.
KLAVIYO_API_KEY=
KLAVIYO_LIST_ID=
KLAVIYO_REVISION=2026-07-15
# Optional overrides:
# KLAVIYO_CONVERSION_METRIC="Placed Order"
# KLAVIYO_SUBSCRIPTION_METRIC="WC Subscription Created"
# KLAVIYO_RENEWAL_METRIC="WC Subscription Renewal"
# KLAVIYO_CURRENCY=GBP
# KLAVIYO_TIMEZONE="Europe/London"   # blank = auto-detect from the Klaviyo account
